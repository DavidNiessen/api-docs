{
  "name": "api-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted API documentation platform",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "eslint . --max-warnings=0",
    "lint:markdown": "markdownlint-cli2",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "build:packages": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "npm run build:packages && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/node"
  ]
}
