{
  "name": "api-docs-planning",
  "version": "0.0.0",
  "private": true,
  "description": "Product planning and repository quality tooling for a self-hosted API documentation platform",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "check": "npm run format:check && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "eslint . --max-warnings=0",
    "lint:markdown": "markdownlint-cli2",
    "check:pr-title": "node scripts/check-pr-title.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10"
  }
}
